# ==============================================================================
# BillingStream Environment Configuration Template
# ==============================================================================

# Database Credentials (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=billingstream

# AI Provider Models & Fallback Chain
# NOTE: Server API keys are NOT required! Users provide their own keys in the
# browser session via Bring-Your-Own-Key (BYOK), or run in free offline Mock mode.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini

# Security & CORS
# Optional shared secret header (X-Inbound-Token) protecting /api/email/inbound webhooks
INBOUND_EMAIL_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Business Rules
# Israeli VAT rate (%) used only when an invoice does not print its own rate
DEFAULT_VAT_RATE=18

# Supabase Authentication & Role-Based Access Control (RBAC)
# Project URL and public anon key (also exposed to frontend via VITE_SUPABASE_*)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Supabase JWT Secret (found in Supabase Dashboard -> Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
# Supabase Service Role Key (backend only, used by Admin API to promote approved users)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Initial Admin Email (Designates the bootstrap administrator upon first registration)
INITIAL_ADMIN_EMAIL=admin@billingstream.local
