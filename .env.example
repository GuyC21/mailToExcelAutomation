# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=billingstream

# AI Provider Keys (leave both empty to run in offline MOCK mode)
GEMINI_API_KEY=
# Ordered fallback chain – the next model is tried on quota (429) / unavailable errors
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash,gemini-2.5-flash,gemini-2.5-flash-lite
# Optional secondary provider, used only if every Gemini model fails
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Business rules: VAT % used only when a document does not print its own rate
DEFAULT_VAT_RATE=18

# Optional shared secret for the inbound-email webhook (header: X-Inbound-Token)
INBOUND_EMAIL_TOKEN=

# Optional Backoffice access key. Empty = open API (fine while every port is bound
# to 127.0.0.1, as in docker-compose.yml). Set it before exposing the API to a
# network; the UI sends it automatically (VITE_API_KEY is wired from it in compose).
BACKOFFICE_API_KEY=

# Supabase Authentication
# Project URL and public anon key (also exposed to frontend via VITE_SUPABASE_*)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Supabase JWT Secret (found in Supabase Dashboard -> Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
# Supabase Service Role Key (backend only, used by Admin API to promote approved users)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Initial Admin Email for auto-bootstrapping
INITIAL_ADMIN_EMAIL=admin@billingstream.local
